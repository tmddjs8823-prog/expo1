# ============================================================
# 환경변수 설정 (개발용)
# 이 파일을 .env로 복사한 뒤 값을 채워주세요
# ============================================================

# ── 데이터베이스 (PostgreSQL) ──
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/expo"

# ── JWT ──
JWT_SECRET="your-jwt-secret-key-here"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── 서버 포트 ──
API_PORT=3000

# ── 카카오 OAuth ──
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:4300/auth/kakao/callback
