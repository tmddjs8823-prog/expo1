// ============================================================
// 공지사항 모델
// ============================================================

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  titleEn   String?
  content   String
  contentEn String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
