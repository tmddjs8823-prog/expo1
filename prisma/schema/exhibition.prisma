// ============================================================
// 전시회 / 참가업체 모델
// ============================================================

model Exhibition {
  id          Int              @id @default(autoincrement())
  title       String
  titleEn     String?
  description String?
  descriptionEn String?
  startDate   DateTime
  endDate     DateTime
  venue       String?
  imageUrl    String?
  linkUrl     String?
  status      ExhibitionStatus @default(DRAFT)
  published   Boolean          @default(false)
  exhibitors  Exhibitor[]
  preRegistrations PreRegistration[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Exhibitor {
  id           Int        @id @default(autoincrement())
  companyName  String
  companyNameEn String?
  description  String?
  boothNumber  String?
  contactEmail String?
  contactPhone String?
  website      String?
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
