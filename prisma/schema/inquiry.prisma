// 문의하기 모델
// ============================================================

model Inquiry {
  id        Int           @id @default(autoincrement())
  name      String?
  email     String?
  subject   String
  content   String
  answer    String?
  status    InquiryStatus @default(PENDING)
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
