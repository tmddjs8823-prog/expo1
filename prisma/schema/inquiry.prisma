model Inquiry {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  content   String
  answer    String?
  status    InquiryStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
