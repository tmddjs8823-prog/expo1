model Gallery {
  id          Int      @id @default(autoincrement())
  title       String
  titleEn     String?
  description String?
  imageUrl    String
  thumbnailUrl String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
