// ============================================================
// 배너 모델
// ============================================================

model Banner {
  id          Int          @id @default(autoincrement())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  published   Boolean      @default(false)
  sortOrder   Int          @default(0)
  exhibitionId Int?
  exhibition   Exhibition?  @relation(fields: [exhibitionId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
